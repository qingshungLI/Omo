# TikHub: China mainland can use https://api.tikhub.dev
TIKHUB_API_KEY=
TIKHUB_BASE_URL=https://api.tikhub.io

# Claude performs image OCR/understanding and the final structured review.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# ASR: OpenAI-compatible /audio/transcriptions endpoint.
# Set OPENAI_API_KEY, or point OPENAI_BASE_URL at a compatible provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ASR_MODEL=gpt-4o-mini-transcribe

MEDIA_WORK_DIR=./data
MAX_DOWNLOAD_MB=500
MAX_FRAMES=12
FRAME_INTERVAL_SECONDS=30
KEEP_MEDIA=false

