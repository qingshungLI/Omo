# Recallo local backend
NODE_ENV=development
HOST=127.0.0.1
PORT=5173
SHIBEI_PUBLIC_BASE_URL=http://127.0.0.1:5173

# Project-local PostgreSQL instance created by the local setup.
DATABASE_URL=postgresql://127.0.0.1:55432/recallo_dev
PGSSLMODE=disable

# Keep the worker disabled until a model key is configured.
GENERATION_WORKER_DISABLED=1

# Choose one model provider. Never commit real keys.
AI_PROVIDER=deepseek
DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_API_KEY=
# OPENAI_MODEL=
# OPENAI_API_KEY=

# Local-only diagnostics.
ENABLE_COST_WORKBENCH=1
VIDEO_LINK_ENABLED=0
# TikHub is optional and only runs on the backend. It enriches user-submitted
# public Douyin/Xiaohongshu video links and Xiaohongshu/WeChat/Zhihu article links.
TIKHUB_CONTENT_ENABLED=1
# TIKHUB_API_KEY=
TIKHUB_BASE_URL=https://api.tikhub.io
TIKHUB_TIMEOUT_MS=30000
# Recallo V3 model-selection benchmark (never commit real keys)
# Qwen/DashScope is required for the direct vision candidates.
DASHSCOPE_API_KEY=
# QWEN_API_KEY= may be used as an alias when DASHSCOPE_API_KEY is unavailable.
QWEN_API_KEY=
